# =============================================================================
# Doce Costura — variáveis de ambiente
# Local: copie para .env.local. Vercel: Settings → Environment Variables.
# NUNCA versione valores reais nem cole senhas/chaves em conversas.
# Variáveis NEXT_PUBLIC_* ficam visíveis no navegador: nada secreto nelas.
# =============================================================================

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Banco de dados (Supabase) --------------------------------------------------
# Supabase → botão "Connect" → "Transaction pooler" (porta 6543).
# Exemplo: postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Fotos (Supabase Storage) ----------------------------------------------------
# Project Settings → API: "Project URL" e a chave secreta (sb_secret_...)
# ou a antiga "service_role". A chave secreta NUNCA vai para o navegador.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# STORAGE_DRIVER=local   # só para desenvolvimento sem Supabase

# --- Login (Better Auth) ---------------------------------------------------------
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Endereço público do site (na Vercel, o domínio de produção)
BETTER_AUTH_URL=http://localhost:3000
# Código para criar o primeiro administrador em /admin/primeiro-acesso (mín. 12 caracteres).
# Depois que o administrador existir, a tela se desativa sozinha; pode remover a variável.
ADMIN_SETUP_TOKEN=

# --- E-mail transacional (recuperação de senha, pedidos) ------------------------
# Sem estas variáveis, em produção a recuperação de senha não envia e-mail.
RESEND_API_KEY=
EMAIL_FROM="Doce Costura <contato@seudominio.com.br>"

# --- Mercado Pago (Etapa 4) — começar com credenciais de TESTE --------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- Melhor Envio (Etapa 4) — começar pelo sandbox --------------------------------
MELHORENVIO_ENV=sandbox
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
MELHORENVIO_ACCESS_TOKEN=
MELHORENVIO_REFRESH_TOKEN=
MELHORENVIO_USER_AGENT="Doce Costura (contato@seudominio.com.br)"

# --- Analytics (opcional; só carregam após consentimento) ------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
