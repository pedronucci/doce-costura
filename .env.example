# =============================================================================
# Doce Costura — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA versione o arquivo com valores reais. Variáveis NEXT_PUBLIC_* ficam
# visíveis no navegador: não coloque segredos nelas.
# =============================================================================

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Banco de dados (Etapa 3) -------------------------------------------------
# PostgreSQL gerenciado (Neon/Supabase). Use conexão com pool para a aplicação.
DATABASE_URL=

# --- Autenticação (Etapa 3) ---------------------------------------------------
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- E-mail transacional (Etapa 3) --------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Doce Costura <contato@seudominio.com.br>"

# --- Armazenamento de imagens (Etapa 3) ---------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Rate limiting (Etapa 3) --------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Mercado Pago (Etapa 4) — comece com credenciais de TESTE ------------------
MERCADOPAGO_ACCESS_TOKEN=            # segredo — somente servidor
MERCADOPAGO_WEBHOOK_SECRET=          # assinatura secreta dos webhooks (painel do MP)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=  # chave pública — usada pelo Payment Brick

# --- Melhor Envio (Etapa 4) — comece pelo sandbox ------------------------------
MELHORENVIO_ENV=sandbox              # sandbox | production
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
MELHORENVIO_ACCESS_TOKEN=
MELHORENVIO_REFRESH_TOKEN=
MELHORENVIO_USER_AGENT="Doce Costura (contato@seudominio.com.br)"

# --- Analytics (opcional; só carregam após consentimento) ---------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
